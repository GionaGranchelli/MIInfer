FROM docker.io/kyuz0/rocm-toolbox-gfx906@sha256:fb0de294a2919ff6d503b4845e055c7fb80db5861954694ee5228e48a14411ec
LABEL org.opencontainers.image.base.name="docker.io/kyuz0/rocm-toolbox-gfx906" \
      org.opencontainers.image.base.digest="sha256:fb0de294a2919ff6d503b4845e055c7fb80db5861954694ee5228e48a14411ec"
USER root
ENV DEBIAN_FRONTEND=noninteractive \
    MIINFER_HIP_ARCHITECTURE=gfx906 \
    MIINFER_TARGET_ARCH=gfx906 \
    PATH=/opt/rocm/llvm/bin:$PATH
RUN apt-get -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
        ca-certificates hipblas-dev pkg-config python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir --break-system-packages cmake==3.30.5
WORKDIR /workspace/MIInfer
